PORT=3000

# Local dev — path to service account file (never commit serviceAccountKey.json)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Cloud deploy (Render/Railway) — prefer base64 to avoid broken private_key newlines:
# FIREBASE_SERVICE_ACCOUNT_BASE64=<output of: base64 -i serviceAccountKey.json | tr -d '\n'>
# Or paste one-line JSON:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

FIREBASE_PROJECT_ID=event-booking-system-ea7a6

# Optional — Firestore emulator for offline dev
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
